<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>HungerMeter</RootNamespace>
    <AssemblyName>HungerMeter</AssemblyName>
    <Version>1.0.0.0</Version>
    <!-- Unlike Milk Meter, nothing here touches FFXIVClientStructs or
         raw pointers (no Job mode, no emote-loop reading), so
         AllowUnsafeBlocks isn't needed. -->
  </PropertyGroup>

  <!--
    Standard Dalamud plugin bootstrap - identical to Milk Meter's own
    csproj. DALAMUD_HOME must point at a local Dalamud dev install; see
    https://dalamud.dev/plugin-development/how-plugins-work.
  -->
  <PropertyGroup>
    <DalamudLibPath>$(DALAMUD_HOME)\</DalamudLibPath>
    <DalamudLibPath Condition="$(DALAMUD_HOME) == ''">$(AppData)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Dalamud">
      <HintPath>$(DalamudLibPath)Dalamud.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lumina">
      <HintPath>$(DalamudLibPath)Lumina.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lumina.Excel">
      <HintPath>$(DalamudLibPath)Lumina.Excel.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Dalamud.Bindings.ImGui">
      <HintPath>$(DalamudLibPath)Dalamud.Bindings.ImGui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- FFXIVClientStructs/InteropGenerator.Runtime deliberately NOT
         referenced - nothing in this barebones project reads raw game
         structs the way Milk Meter's JobScale.cs/EmoteLoopTracker.cs
         do. Add them back (see MilkMeter.csproj) if you extend this
         plugin with anything that needs them. -->
  </ItemGroup>

  <!-- No EmbeddedResource / System.Windows.Extensions entries - this
       barebones plugin has no sound effects (Milk Meter's threshold-
       effect heartbeat/moan/burp sounds), so neither is needed. -->

</Project>
